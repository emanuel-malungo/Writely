# Groq API Configuration
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here
